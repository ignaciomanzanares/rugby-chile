DATABASE_URL="postgresql://rugby_user:rugby_pass@localhost:5432/rugby_chile"
PORT=4000
WEB_URL="http://localhost:3000"

# OBLIGATORIO — secreto para firmar los cookies de sesión (JWT). La API NO
# arranca sin esto (fail-closed, sin default). Generá uno fuerte con:
#   openssl rand -hex 32
JWT_SECRET=""

# Notificaciones push (opcional). Sin estas, los endpoints /push responden pero
# no envían nada. Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu@email.com"
