# Database
DATABASE_URL="postgresql://user:password@localhost:5432/rugby_chile"

# Seed: email del usuario ADMIN a crear con `npm run db:seed`. Si NO está
# definido, el seed NO crea ningún admin (fail-closed, sin default).
SEED_ADMIN_EMAIL=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Optional: OAuth providers
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Optional: Image upload (Cloudinary)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
